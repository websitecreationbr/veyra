{
  "name": "veyra-android",
  "private": true,
  "version": "2.0.0",
  "description": "Empacotamento Android (Capacitor) da VEYRA AI. Usa o mesmo front e a mesma API do site.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:web": "npm --prefix ../web install && npm --prefix ../web run build",
    "android:add": "cap add android && node scripts/android-setup.mjs",
    "android:setup": "node scripts/android-setup.mjs",
    "android:sync": "cap sync android && node scripts/android-setup.mjs",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
