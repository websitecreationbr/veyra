{
  "name": "@veyra/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API da Veyra — Node puro (node:http + node:sqlite), sem dependências de runtime.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "seed": "tsx src/demo/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
