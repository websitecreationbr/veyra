# Porta da API (e do site, em produção)
PORT=8787

# PostgreSQL (produção). Se definido, o app usa PostgreSQL em vez do SQLite local.
# Na Vercel isto é OBRIGATÓRIO. Exemplo: postgres://usuario:senha@host:5432/banco?sslmode=require
# DATABASE_URL=
# DATABASE_SSL=            # "disable" ou "no-verify" só se o provedor exigir
# PG_POOL_MAX=3

# Onde fica o banco SQLite (só quando DATABASE_URL não está definida). Padrão: server/.data/veyra.db
# VEYRA_DATA_DIR=./.data

# IA em nuvem (opcional). Sem a chave, a Veyra usa o interpretador local,
# que entende comandos simples em português mas é mais limitado.
# A chave fica SOMENTE no servidor — nunca é enviada ao navegador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Origens extras autorizadas a chamar a API com cookies (separadas por vírgula).
# Em desenvolvimento, localhost:5173 já é aceito.
# ALLOWED_ORIGINS=https://app.seudominio.com

# Defina como 1 se estiver atrás de um proxy reverso (Nginx, Fly, Render...)
# para que o limite de requisições use o IP real do cliente.
# TRUST_PROXY=1

# Em produção os cookies de sessão são "Secure" (exigem HTTPS). Para testar `npm start`
# em http://localhost, defina COOKIE_SECURE=0. Nunca use 0 em um servidor público.
# COOKIE_SECURE=0
