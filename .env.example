# Variáveis para publicar na Vercel (Settings → Environment Variables). Nunca coloque valores reais neste arquivo.
# Para rodar localmente use server/.env (veja server/.env.example).

# OBRIGATÓRIA na Vercel: connection string do PostgreSQL hospedado (Neon, Supabase, Vercel Postgres...).
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

# Opcional: liga a IA em nuvem. Fica só no servidor.
ANTHROPIC_API_KEY=

# Opcionais
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ALLOWED_ORIGINS=https://seu-dominio-extra.com
# PG_POOL_MAX=3
# DATABASE_SSL=no-verify   # só se o seu provedor exigir (o padrão verifica o certificado)
