# Variáveis para publicar na Vercel (Settings → Environment Variables). Nunca coloque valores reais neste arquivo.
# Para rodar localmente use server/.env (veja server/.env.example).

# OBRIGATÓRIA na Vercel: connection string do PostgreSQL hospedado (Neon, Supabase, Vercel Postgres...).
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

# Opcional: liga a IA em nuvem (conversa livre). Fica só no servidor. Use UMA das opções (todas têm plano gratuito, exceto a última):
GEMINI_API_KEY=          # Google AI Studio (aistudio.google.com/apikey) — gratuito, com limites
# GROQ_API_KEY=          # console.groq.com — gratuito, com limites
# OPENROUTER_API_KEY=    # openrouter.ai — modelos ":free" com limites
# AI_PROVIDER=gemini     # escolhe o provedor se houver mais de uma chave (gemini | groq | openrouter | custom | anthropic)
# AI_MODEL=              # troca o modelo padrão do provedor
# AI_BASE_URL= AI_API_KEY=   # provedor próprio compatível com a API da OpenAI (AI_PROVIDER=custom)
# ANTHROPIC_API_KEY=     # Claude (pago; não é necessário)

# Opcionais do app Android / mercado
# APP_ORIGINS=https://localhost        # origens do app (o padrão já inclui https://localhost e capacitor://localhost)
# BRAPI_TOKEN=                         # token gratuito da brapi.dev (Ibovespa), se o acesso sem token atingir o limite
# AWESOMEAPI_TOKEN=                    # token gratuito da AwesomeAPI (dólar), se necessário

# Opcionais
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ALLOWED_ORIGINS=https://seu-dominio-extra.com
# PG_POOL_MAX=3
# DATABASE_SSL=no-verify   # só se o seu provedor exigir (o padrão verifica o certificado)
